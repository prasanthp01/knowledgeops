FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
# Start directly as postgres, so the Go privilege-switch helper is unnecessary.
# Its bundled Go runtime had fixable advisories. Remove the unused executable
# instead of suppressing those findings; retain all package/license metadata.
RUN apk upgrade --no-cache && rm /usr/local/bin/gosu
USER postgres

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=5 CMD pg_isready -U postgres
