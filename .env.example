KO_DATABASE_URL=postgresql://knowledgeops_app:REPLACE_FROM_SECRET_STORE@127.0.0.1:5432/knowledgeops
KO_PUBLIC_ORIGIN=http://127.0.0.1:8044
KO_SECURE_COOKIES=false
# Optional private operator endpoint; disabled when empty. Minimum 32 random characters.
KO_PRIVATE_TOKEN=
KO_PRIVATE_TENANT=private
KO_PRIVATE_ROLE=engineering
# Current AgentOps content integration is unavailable; keep this disabled.
KO_AGENTOPS_CONTENT_CONTRACT=disabled
KO_AGENTOPS_URL=
KO_AGENTOPS_TOKEN=
KO_AGENTOPS_POLICY_EXPIRES=
KO_AGENTOPS_POLICY_VERSION=
KO_PRIVATE_DAILY_BUDGET=0
KO_PRIVATE_REQUEST_BUDGET=0

# Opt-in Contracts API factory; use a separate synthetic database and matching worker.
# Required when launching knowledgeops.contracts_api:create_app --factory.
KO_CONTRACTS_SOURCE_REVISION=
KO_CONTRACTS_ENVIRONMENT=development
# Trusted mode-0600 server grant file; empty disables cross-app knowledge queries.
KO_KNOWLEDGE_CREDENTIALS_FILE=

# Optional server-owned synthetic AgentOps profile, mode 0600; empty disables the caller.
# This does not activate the private content proposal or connect default workflows.
KO_AGENTOPS_SYNTHETIC_PROFILE_FILE=

