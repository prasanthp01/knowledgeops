  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PrivateInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Question"
          },
          "collections": {
            "items": {
              "type": "string",
              "enum": [
                "people",
                "operations",
                "security",
                "finance"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Collections"
          },
          "operation_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 16,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Operation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "operation_id"
        ],
        "title": "PrivateInput"
      },
      "SearchInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Question"
          },
          "role": {
            "type": "string",
            "enum": [
              "staff",
              "engineering",
              "security",
              "finance"
            ],
            "title": "Role",
            "default": "staff"
          },
          "corpus": {
            "type": "string",
            "const": "atlas-synthetic",
            "title": "Corpus",
            "default": "atlas-synthetic"
          },
          "collections": {
            "items": {
              "type": "string",
              "enum": [
                "people",
                "operations",
                "security",
                "finance"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Collections"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "bm25",
              "keyword"
            ],
            "title": "Algorithm",
            "default": "bm25"
          },
          "top_k": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 3
          },
          "revision": {
            "type": "string",
            "enum": [
              "current",
              "previous",
              "conflict"
            ],
            "title": "Revision",
            "default": "current"
          },
          "keyword_filter": {
            "type": "string",
            "maxLength": 80,
            "title": "Keyword Filter",
            "default": ""
          },
          "seed": {
            "type": "integer",
            "maximum": 4294967295.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "SearchInput"
      },
      "SimulationStart": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "project_id": {
            "type": "string",
            "const": "knowledgeops",
            "title": "Project Id",
            "default": "knowledgeops"
          },
          "mode": {
            "type": "string",
            "enum": [
              "SANDBOX_DETERMINISTIC",
              "REPLAY_RECORDED"
            ],
            "title": "Mode",
            "default": "SANDBOX_DETERMINISTIC"
          },
          "preset_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset Id"
          },
          "input": {
            "$ref": "#/components/schemas/SearchInput"
          },
          "client_correlation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Correlation Id"
          },
          "replay_run_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Run Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input"
        ],
        "title": "SimulationStart"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
